<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- merged with the generated Info.plist (GENERATE_INFOPLIST_FILE stays YES) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- the Mac app talks to the dashboard server on http://127.0.0.1:8787;
		     the iPhone uses the HTTPS tailnet URL, which needs no exception -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID unlocks your saved trading PIN to quickly arm control actions.</string>
</dict>
</plist>
